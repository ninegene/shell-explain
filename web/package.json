{
  "name": "shell-explain-web",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "content": "node scripts/export.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "predev": "npm run content",
    "dev": "astro dev --host 127.0.0.1",
    "prebuild": "npm run content",
    "build": "astro build",
    "precheck": "npm run content",
    "check": "astro check",
    "preview": "astro preview --host 127.0.0.1",
    "pretest": "node scripts/test-prepare.mjs",
    "test": "npm run test:dev && playwright test",
    "test:dev": "node --test scripts/content-watch.test.mjs"
  },
  "dependencies": {
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "~5.9.3"
  }
}
