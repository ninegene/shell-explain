---
import Layout from '../layouts/Layout.astro';
import Catalog from '../components/Catalog.astro';
import { commands } from '../lib/catalog';
const entries = await commands();
const featured = entries.find((entry) => entry.id === 'grep') ?? entries[0];
const examples = featured.data.sections.find(
  (section) =>
    section.implementation === 'common' && section.title === 'Examples',
)!.code;
const example = (examples[1] ?? examples[0])?.trim();
const explanation =
  featured.data.sections.find((section) => section.options.includes('-n')) ??
  featured.data.sections.find(
    (section) =>
      section.implementation === 'common' && section.title === 'Overview',
  )!;
---

<Layout title="Know what you type">
  <section class="hero">
    <div>
      <div class="eyebrow">LESS GUESSING. MORE UNDERSTANDING.</div>
      <h1>
        Know what you're
        <br />
        about to <em>type.</em>
      </h1>
      <p class="lede">
        Small, practical explanations for shell commands.
        <br />
        Useful examples. Clear options. The right implementation.
      </p>
      <a class="text-link" href="#reference">
        Explore the reference <span aria-hidden="true">↓</span>
      </a>
    </div>
    <div class="hero-terminal" aria-label="Example of the local explain CLI">
      <div class="terminal-bar">
        <span></span>
        <span></span>
        <span></span>
        <small>YOUR TERMINAL, EXPLAINED</small>
      </div>
      <div class="terminal-content">
        <p>
          <span>$</span> explain {featured.id}
        </p>
        <h2>{featured.data.summary}</h2>
        <p class="terminal-muted">One command, step by step.</p>
        {example && <code>{example}</code>}
        <div class="terminal-rule"></div>
        <div class="terminal-muted" set:html={explanation.html} />
        <p class="terminal-caption">ONE MARKDOWN SOURCE · WEB + CLI</p>
      </div>
    </div>
  </section>
  <section id="reference" class="catalog-section">
    <div class="eyebrow">START WITH A USE CASE</div>
    <Catalog />
  </section>
</Layout>
