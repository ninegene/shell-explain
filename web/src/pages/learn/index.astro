---
import Layout from '../../layouts/Layout.astro';
import {
  activeSeries,
  glossary,
  glossaryURL,
  guideNumber,
  guideURL,
  guidesIn,
} from '../../lib/guides';
---

<Layout
  title="Learn the terminal"
  description="Beginner guides to the terminal, the shell, and why one command has many versions."
>
  <div class="page-intro">
    <div class="eyebrow">NEW TO THE TERMINAL?</div>
    <h1>
      Learn it from the ground up<span class="brand-dot">.</span>
    </h1>
    <p class="lede">
      Plain-language guides, with pictures and tables, for anyone who has never
      used a shell. Read them in order, or pick the one you need.
    </p>
    <p class="lede">
      Prefer your terminal? Run <code>explain learn</code>.
    </p>
  </div>
  <section class="catalog-section learn-index">
    {activeSeries().map((s) => (
      <section class="series-section" aria-labelledby={`series-${s.id}`}>
        <h2 id={`series-${s.id}`}>{s.title}</h2>
        <p class="series-promise">{s.promise}</p>
        <ol class="guide-list">
          {guidesIn(s.id).map((g) => (
            <li class="command-card guide-card">
              <span class="guide-number" aria-hidden="true">
                {guideNumber(g.id)}
              </span>
              <div>
                <h3>
                  <a href={guideURL(g.id)}>{g.title}</a>
                </h3>
                <p>{g.summary}</p>
                <small>About {g.reading_minutes} minutes</small>
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))}
    <section class="series-section">
      <h2>
        <a href={glossaryURL()}>{glossary.title}</a>
      </h2>
      <p class="series-promise">{glossary.summary}</p>
    </section>
  </section>
</Layout>
