---
import { commands, labels } from '../lib/catalog';
import { glossary, glossaryURL, guides, guideURL } from '../lib/guides';
interface Props {
  tag?: string;
}
const { tag } = Astro.props;
const entries = (await commands()).filter(
  (e) => !tag || e.data.tags.includes(tag),
);
// Guides and glossary words are searched with the commands, but only on the
// main catalog: a tag page lists commands for one tag.
const learn = !tag;
// A guide is also found by the glossary words that point to it, so "stderr"
// finds the guide on the three streams even though its summary says "errors".
const wordsFor = (id: string) =>
  glossary.terms.filter((t) => t.guides.includes(id)).map((t) => t.term);
const plain = (markdown: string) => markdown.replace(/`/g, '');
const firstSentence = (markdown: string) =>
  plain(markdown).split(/(?<=\.)\s/)[0];
---

<div class="catalog" data-catalog>
  <form class="search-form" role="search">
    <div class="search-field">
      <label for="query">Find a command or a use case</label>
      <input
        id="query"
        name="q"
        type="search"
        placeholder="Try grep, replace, directories, or stderr…"
        autocomplete="off"
      />
    </div>
    <div>
      <label for="implementation">Implementation coverage</label>
      <select id="implementation" name="implementation">
        <option value="">All implementations</option>
        {Object.entries(labels)
          .filter(([k]) => k !== 'common')
          .map(([key, label]) => (
            <option value={key}>{label}</option>
          ))}
      </select>
    </div>
    <button class="button" type="submit">
      Search
    </button>
  </form>
  <div class="catalog-heading">
    <p id="result-count" role="status" aria-live="polite">
      {entries.length} commands
    </p>
    <span>SMALL REFERENCE. USEFUL DETAILS.</span>
  </div>
  <div class="command-grid">
    {entries.map((entry) => (
      <article
        class="command-card"
        data-entry
        data-search={[
          entry.id,
          entry.data.summary,
          ...(entry.data.aliases ?? []),
          ...entry.data.tags,
        ]
          .join(' ')
          .toLowerCase()}
        data-implementations={entry.data.implementations.join(' ')}
      >
        <div class="card-top">
          <span class="prompt" aria-hidden="true">
            $
          </span>
          <h2>
            <a href={`/commands/${entry.id}/`}>{entry.data.title}</a>
          </h2>
          <span class="card-arrow" aria-hidden="true">
            ↗
          </span>
        </div>
        <p>{entry.data.summary}</p>
        <div class="tags">
          {entry.data.tags.map((t) => (
            <a href={`/tags/${t}/`}>#{t}</a>
          ))}
        </div>
        <div class="coverage">
          {entry.data.implementations.map((i) => labels[i]).join(' / ')}
        </div>
      </article>
    ))}
  </div>
  {learn && (
    <section class="learn-results" data-learn-results hidden>
      <h2 id="learn-heading">Guides and words</h2>
      <ul class="learn-list" aria-labelledby="learn-heading">
        {guides.map((g) => (
          <li
            data-learn="guide"
            data-search={[
              g.title,
              g.subtitle,
              g.summary,
              ...g.tags,
              ...wordsFor(g.id),
            ]
              .join(' ')
              .toLowerCase()}
          >
            <a href={guideURL(g.id)}>{g.title}</a>
            <span class="learn-kind">Guide</span>
            <p>{g.summary}</p>
          </li>
        ))}
        {glossary.terms.map((t) => (
          <li
            data-learn="term"
            data-search={[t.term, plain(t.markdown)].join(' ').toLowerCase()}
          >
            <a href={glossaryURL(t.id)}>{t.term}</a>
            <span class="learn-kind">Word</span>
            <p>{firstSentence(t.markdown)}</p>
          </li>
        ))}
      </ul>
      <p id="learn-more" hidden>
        More words match. <a href={glossaryURL()}>See the full glossary.</a>
      </p>
    </section>
  )}
  <p id="no-results" class="empty-state" hidden>
    No matching commands, guides or words yet. Try a shorter query or choose all
    implementations.
  </p>
</div>
<script>
  const catalog = document.querySelector<HTMLElement>('[data-catalog]');
  if (catalog) {
    const form = catalog.querySelector<HTMLFormElement>('form')!;
    const query = catalog.querySelector<HTMLInputElement>('#query')!;
    const impl = catalog.querySelector<HTMLSelectElement>('#implementation')!;
    const cards = [...catalog.querySelectorAll<HTMLElement>('[data-entry]')];
    const learnSection = catalog.querySelector<HTMLElement>(
      '[data-learn-results]',
    );
    const learnItems = [
      ...catalog.querySelectorAll<HTMLElement>('[data-learn]'),
    ];
    const learnMore = catalog.querySelector<HTMLElement>('#learn-more');
    // Few words are shown at a time; the glossary page has the rest.
    const maxWords = 8;
    const apply = () => {
      const words = query.value
        .toLowerCase()
        .trim()
        .split(/\s+/)
        .filter(Boolean);
      let count = 0;
      for (const card of cards) {
        const visible =
          words.every((w) => card.dataset.search!.includes(w)) &&
          (!impl.value ||
            card.dataset.implementations!.split(' ').includes(impl.value));
        card.hidden = !visible;
        if (visible) count++;
      }
      // Guides and words are not specific to one implementation, so they
      // appear only for a typed query with no implementation chosen.
      let learnCount = 0;
      let wordsShown = 0;
      let wordsHidden = false;
      for (const item of learnItems) {
        let visible =
          !!learnSection &&
          words.length > 0 &&
          !impl.value &&
          words.every((w) => item.dataset.search!.includes(w));
        if (visible && item.dataset.learn === 'term') {
          if (wordsShown >= maxWords) {
            visible = false;
            wordsHidden = true;
          } else wordsShown++;
        }
        item.hidden = !visible;
        if (visible) learnCount++;
      }
      if (learnSection) learnSection.hidden = learnCount === 0;
      if (learnMore) learnMore.hidden = !wordsHidden;
      const noun = count === 1 ? 'command' : 'commands';
      catalog.querySelector('#result-count')!.textContent =
        learnCount > 0
          ? `${count} ${noun}, ${learnCount} ${learnCount === 1 ? 'guide or word' : 'guides and words'}`
          : `${count} ${noun}`;
      catalog.querySelector<HTMLElement>('#no-results')!.hidden =
        count > 0 || learnCount > 0;
      const url = new URL(location.href);
      if (query.value) url.searchParams.set('q', query.value);
      else url.searchParams.delete('q');
      if (impl.value) url.searchParams.set('implementation', impl.value);
      else url.searchParams.delete('implementation');
      history.replaceState(null, '', url);
    };
    const restore = () => {
      const params = new URLSearchParams(location.search);
      query.value = params.get('q') ?? '';
      impl.value = params.get('implementation') ?? '';
      apply();
    };
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      apply();
    });
    query.addEventListener('input', apply);
    impl.addEventListener('change', apply);
    window.addEventListener('popstate', restore);
    restore();
  }
</script>
